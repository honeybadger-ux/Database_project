# ==============================================================================
# Multi-Hub Courier & Logistics System - Production Environment Configuration
# ==============================================================================

# Database Credentials
POSTGRES_USER=courier
POSTGRES_PASSWORD=courier123
POSTGRES_DB=courier_logistics
DATABASE_URL=postgresql://courier:courier123@db:5432/courier_logistics

# Security & Authentication (Generate using: openssl rand -hex 32)
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# CORS Configuration (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Environment Mode
ENVIRONMENT=production
